# Copy to .env and adjust. Settings are loaded by app/core/config.py.
# .env is gitignored — never commit real secrets.

# PostgreSQL connection (psycopg 3 driver). Must point at a running database
# before `uv run alembic upgrade head` or the app can serve requests.
DATABASE_URL=postgresql+psycopg://vetbreath:vetbreath@localhost:5432/vetbreath

# JWT signing key (≥32 bytes). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-ME

# Transactional email sender (FR-003 invitations, FR-013 password reset).
EMAIL_FROM=no-reply@vetbreath.local
